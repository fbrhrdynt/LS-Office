[Unit]
Description=LogiSource AI Office Agent Worker
After=network.target postgresql.service ls-office-api.service
Wants=postgresql.service

[Service]
Type=simple
User=ls-office
Group=ls-office
WorkingDirectory=/opt/ls-office
EnvironmentFile=/etc/ls-office/api.env
ExecStart=/usr/bin/node /opt/ls-office/server/worker.mjs
Restart=on-failure
RestartSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ls-office
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=250M
CPUQuota=40%

[Install]
WantedBy=multi-user.target
