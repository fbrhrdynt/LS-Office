[Unit]
Description=LogiSource AI Office Agent Worker (AI steps, QA, chat)
After=network.target postgresql.service ls-office-api.service
Wants=postgresql.service

[Service]
Type=simple
User=ls-office
Group=ls-office
WorkingDirectory=/opt/ls-office
EnvironmentFile=/etc/ls-office/api.env
Environment=HOME=/var/lib/ls-office XDG_CACHE_HOME=/var/lib/ls-office/.cache
ExecStart=/usr/bin/node /opt/ls-office/server/worker.mjs
Restart=on-failure
RestartSec=8
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/ls-office
MemoryMax=300M
CPUQuota=40%

[Install]
WantedBy=multi-user.target
